#!name=YouTube（Shadowrocket）
#!desc=YouTube/YouTube Music 
#!homepage=https://github.com/Maasea/sgmodule
[Rule]
# 阻止 QUIC/HTTP3 绕过 HTTPS 解密和响应脚本
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP)),REJECT
[URL Rewrite]
# 丢弃通用广告统计与追踪请求
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject
[Script]
# YouTube API 使用 protobuf/binary body，必须开启 binary-body-mode
youtube.response = type=http-response,pattern=^https:\/\/(youtubei|youtubei-att)\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{"captionLang":"off"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/(youtubei|youtubei-att)\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js
[MITM]
# 模块必须使用 %APPEND%，避免覆盖主配置或其他模块的解密域名
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, s.youtube.com

#!name=哲也同学（知乎净化）
#!desc=知乎去广告、内容净化及本地功能增强（Shadowrocket 模块）
#!author=哲也同学 / Shadowrocket format conversion
#!category=去广告

[URL Rewrite]
# 拦截异常地址
^https?:\/\/118\.89\.204\.198(?:\/|$) - reject-dict
^https?:\/\/103\.41\.167\.237(?:\/|$) - reject-dict
^https?:\/\/\[2402:4e00:1200:ed00:0:9089:6dac:96b6\](?:\/|$) - reject-200

# 拦截开屏广告及商业接口
^https?:\/\/api\.zhihu\.com\/commercial_api(?:\/|\?|$) - reject-dict
# 拦截不影响使用的请求
^https?:\/\/api\.zhihu\.com\/message-push\/event(?:\/|\?|$) - reject-dict
# 屏蔽付费回答用户营销引导
^https?:\/\/api\.zhihu\.com\/guide_center\/strategy(?:\/|\?|$) - reject-dict
# 屏蔽会员页浮动广告
^https?:\/\/api\.zhihu\.com\/bazaar\/float_window(?:\/|\?|$) - reject-dict
# 屏蔽数据上报
^https?:\/\/api\.zhihu\.com\/metrics\/report(?:\/|\?|$) - reject-dict
# 屏蔽疑似通知
^https?:\/\/api\.zhihu\.com\/settings\/new\/notification(?:\/|\?|$) - reject-dict
# 屏蔽会员相关广告
^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header(?:\/|\?|$) - reject-dict
# 去除消息通知角标
^https?:\/\/api\.zhihu\.com\/notifications\/v\d\/count(?:\/|\?|$) - reject-dict
# 去除推荐页顶部广告
^https?:\/\/api\.zhihu\.com\/root\/window(?:\/|\?|$) - reject-dict
# 拦截应用内弹窗
^https?:\/\/api\.zhihu\.com\/me\/guides(?:\/|\?|$) - reject-dict
# 去除关注页最常访问
^https?:\/\/api\.zhihu\.com\/moments\/recent(?:\/|\?|$) - reject-dict
# 拦截推荐页顶部广告
^https?:\/\/api\.zhihu\.com\/api\/v4\/ecom_data\/config(?:\/|\?|$) - reject-dict
# 屏蔽推荐页内容更新红点
^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/tag_config(?:\/|\?|$) - reject-dict
# 屏蔽部分推荐页 Tab 的 Banner
^https?:\/\/api\.zhihu\.com\/content-distribution-core\/sections\/ - reject-dict

[Script]
# 获取用户信息：隔离用户数据、开启本地会员等
知乎_用户信息 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/people\/, requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 关键词屏蔽：解锁本地关键词屏蔽功能，需要开启本地 VIP
知乎_关键词屏蔽 = type=http-request, pattern=^https?:\/\/api\.zhihu\.com\/feed-root\/block(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 优化下发的软件配置
知乎_软件配置 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/root\/tab\/v2(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 推荐页：移除黑名单用户发布的文章、去除广告及自定义屏蔽项目
知乎_推荐页 = type=http-response, pattern=^https:\/\/(api|web-render)\.zhihu\.com\/topstory\/recommend(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 回答列表：移除黑名单用户的回答、去除广告
知乎_回答列表 = type=http-response, pattern=^https:\/\/api\.zhihu\.com\/questions\/\d+\/feeds?\?, requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 回答信息流：移除黑名单用户的回答、去除广告
知乎_回答信息流 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/next-render(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 消息页：折叠官方消息、屏蔽营销消息
知乎_消息页 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/notifications\/v3\/(message|timeline\/entry\/system_message)(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 评论页：去除黑名单用户发表的评论
知乎_评论页 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/(comment_v5\/)?(answers|comments?|articles|pins)\/\d+\/(root_|child_)?comments?(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 回答页：移除相关问题推荐
知乎_回答页 = type=http-response, pattern=^https:\/\/(page-info|api)\.zhihu\.com\/answers\/v2\/\d+(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 文章页：移除相关问题推荐
知乎_文章页 = type=http-response, pattern=^https:\/\/api\.zhihu\.com\/articles\/v\d\/\d+(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 关注页：屏蔽黑名单用户
知乎_关注页 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/moments_v3\?, requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 热榜页：去除广告
知乎_热榜页 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/topstory\/hot-lists(?:\?|\/), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 搜索页：去除预置广告
知乎_搜索预置词 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/search\/preset_words\?, requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 搜索页：猜你喜欢去广告
知乎_搜索推荐 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/search\/recommend_query(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 黑名单页：同步黑名单数据
知乎_黑名单 = type=http-response, pattern=^https:\/\/api\.zhihu\.com\/settings\/blocked_users(?:\/|\?|$), requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

# 回答页底部评论摘要：移除黑名单用户发表的评论
知乎_评论摘要 = type=http-response, pattern=^https?:\/\/www\.zhihu\.com\/api\/v4\/comment_v5\/answers\/\d+\/abstract_comment\?, requires-body=1, max-size=0, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js

[MITM]
hostname = %APPEND% 118.89.204.198, 103.41.167.237, 2402:4e00:1200:ed00:0:9089:6dac:96b6, www.zhihu.com, api.zhihu.com, zhuanlan.zhihu.com, m-cloud.zhihu.com, page-info.zhihu.com, web-render.zhihu.com
